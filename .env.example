# Copie este arquivo para ".env" (o .env NUNCA vai para o Git) e preencha os valores.
# Formato: NOME=valor  (sem aspas e sem espaços ao redor do "=")

# --- Sponte (WSAPIEdu) ---
SPONTE_COD_CLIENTE=000000
SPONTE_TOKEN=cole_o_token_aqui

# --- PostgreSQL (DW) ---
# Dentro do Docker o container etl ignora PG_HOST/PG_PORT/PG_DB e usa "postgres:5432/sponte_dw"
# (definidos no docker-compose.yml). Aqui valem para rodar os scripts direto na sua máquina.
PG_HOST=localhost
PG_PORT=5432
PG_DB=sponte_dw
PG_USER=postgres
PG_PASSWORD=sua_senha_do_postgres

# --- n8n --- (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Evolution API --- (openssl rand -hex 24)
EVOLUTION_API_KEY=
EVOLUTION_SERVER_URL=http://localhost:8080

# --- Carga automática (container etl) ---
# Intervalo entre o FIM de uma carga e o início da próxima (meça a 1ª carga e ajuste)
ETL_INTERVAL_MINUTES=360
ETL_STEPS=python carga_unificada.py
FREQ_MODO=completa
# Se o ciclo falhar (banco indisponível, erro na etapa), tenta de novo após este intervalo
ETL_RETRY_MINUTES=10
# Tolerância para o Postgres ainda subindo no boot (tentativas x 5s)
PG_CONNECT_RETRIES=40
# Tempo máximo de cada etapa antes de ser abortada (em minutos)
ETL_STEP_TIMEOUT_MIN=180
